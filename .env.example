# Copy to .env; docker compose reads it automatically.
# The defaults run the offline demo with no API key.
LLM_PROVIDER=fake
STT_PROVIDER=fake
GROQ_API_KEY=

# Bearer token for the admin dashboard (16+ characters). Empty disables admin.
ADMIN_TOKEN=

# Host ports, if 3000 or 8000 are already in use.
WEB_PORT=3000
API_PORT=8000
