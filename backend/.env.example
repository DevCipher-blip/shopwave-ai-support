# Groq key for the LLM and Whisper speech-to-text: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# "groq" calls the real APIs. "fake" swaps in a deterministic demo model and a
# fixed transcript, so the app runs offline with no key.
LLM_PROVIDER=groq
STT_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Bearer token for /api/admin/* and the admin dashboard (16+ characters).
# Leave empty to disable admin access entirely.
ADMIN_TOKEN=

DATABASE_URL=sqlite+aiosqlite:///./shopwave.db
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
MAX_AUDIO_BYTES=10485760
